@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef NOBLESSE_DIMMING_H
+#define NOBLESSE_DIMMING_H
+#include "noblesse-panel-seq.h"
+struct nd_context;
+struct nd_input {
+	/* Caller assertions after independent successful reads; no hardware reader here.
+	 * ID[0] 0x40 establishes SDC vendor only, not large-panel geometry. */
+	bool large_panel_verified, id_read_ok, mtp_read_ok, vbias_read_ok;
+	np_u8 id[3], base_vbias;
+	const np_u8 *mtp;
+	size_t mtp_len; /* Exactly the first 34 bytes of the stock 46-byte C8 read. */
+};
+struct nd_frame {
+	struct np_sdc_cal cal;
+	bool has_vint;
+	np_u8 vint[2], id3;
+	unsigned int level; /* 0..73, not Android's 0..255 brightness. */
+};
+/* All allocations are per-instance. Failure leaves *out NULL.
+ * No fallback calibration, no DSI, GPIO, regulator or backlight registration. */
+int nd_create(const struct nd_input *, struct nd_context **out);
+void nd_destroy(struct nd_context *);
+/* temperature_byte is the stock ELVSS byte already computed by a future caller.
+ * This API does NOT implement temperature measurement or compensation policy. */
+int nd_prepare(const struct nd_context *, unsigned int brightness_0_100,
+	       bool enable_hop, np_u8 temperature_byte, struct nd_frame *out);
+/* Optional explicit packet dispatcher for mock tests / future locked transport.
+ * Not called or registered by this package. After any error, tries key-off;
+ * preserves first error. No assertion of panel rollback or persistent semantics. */
+int nd_send(const struct nd_frame *, const struct np_io *);
+#endif
