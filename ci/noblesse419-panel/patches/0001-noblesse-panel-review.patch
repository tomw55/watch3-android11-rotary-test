@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/delay.h>
+#include "exynos_panel_drv.h"
+#include "noblesse-panel-seq.h"
+
+static int noblesse_write(void *cookie, enum np_packet type,
+			  const np_u8 *bytes, size_t count)
+{
+	struct dsim_device *dsim = cookie;
+	/* Keep original packet type, including three-byte BOE long writes. */
+	if (type == NP_SHORT && count == 1)
+		return dsim_write_data(dsim, type, bytes[0], 0, true);
+	if (type == NP_SHORT_PARAM && count == 2)
+		return dsim_write_data(dsim, type, bytes[0], bytes[1], true);
+	if (type == NP_LONG && count >= 1 && count <= 35)
+		return dsim_write_data(dsim, type, (unsigned long)bytes, (u32)count, true);
+	return -EINVAL;
+}
+
+static void noblesse_delay(void *cookie, unsigned int duration)
+{
+	(void)cookie;
+	msleep(duration);
+}
+
+/* No panel_ops registration: IDs, calibration provider, brightness and power
+ * sequencing are deliberately not fabricated. Future caller must use this
+ * only after regulators, reset and DSIM have been independently validated. */
+int noblesse_panel_sequence(struct exynos_panel_device *panel, enum np_action action,
+			    const struct np_config *config)
+{
+	struct np_io io;
+	struct dsim_device *dsim;
+	int ret;
+	if (!panel || !config)
+		return -EINVAL;
+	dsim = get_dsim_drvdata(panel->id);
+	if (!dsim)
+		return -ENODEV;
+	io.cookie = dsim;
+	io.write = noblesse_write;
+	io.delay_ms = noblesse_delay;
+	mutex_lock(&panel->ops_lock);
+	ret = np_run(action, config, &io);
+	mutex_unlock(&panel->ops_lock);
+	return ret;
+}
