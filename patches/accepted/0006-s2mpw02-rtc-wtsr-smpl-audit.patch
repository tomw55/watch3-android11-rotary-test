--- a/drivers/rtc/Kconfig
+++ b/drivers/rtc/Kconfig
@@ -1321,6 +1321,21 @@
 	  This driver can also be built as a module. If so, the module
 	  will be called rtc-s2mpw02.
 
+config RTC_DRV_S2MPW02_NOBLESSE_AUDIT
+	bool "Skip unconditional S2MPW02 RTC WTSR/SMPL write"
+	depends on NOBLESSE && RTC_DRV_S2MPW02
+	default n
+	help
+	  Skip the unconditional WTSR/SMPL policy write in
+	  s2m_rtc_enable_wtsr_smpl(), which fires on every probe
+	  using board devicetree values. Does not change
+	  s2m_rtc_init_reg()'s conditional CTRL/CAPSEL/init-time
+	  path, whose write depends on live chip register state
+	  this source cannot establish; that path is left for
+	  separate review. RTC registration, alarm and read/write
+	  paths can still write registers. This option is intended
+	  for offline auditing.
+
 config RTC_DRV_EP93XX
 	tristate "Cirrus Logic EP93XX"
 	depends on ARCH_EP93XX || COMPILE_TEST
--- a/drivers/rtc/rtc-s2mpw02.c
+++ b/drivers/rtc/rtc-s2mpw02.c
@@ -525,6 +525,7 @@
 			pdata->wtsr_smpl->wtsr_en ? "enable" : "disable",
 			pdata->wtsr_smpl->smpl_en ? "enable" : "disable");
 
+#ifndef CONFIG_RTC_DRV_S2MPW02_NOBLESSE_AUDIT
 	ret = s2mpw02_write_reg(info->i2c, S2MP_RTC_REG_WTSR_SMPL, val);
 	if (ret < 0) {
 		dev_err(info->dev, "%s: fail to write WTSR/SMPL reg(%d)\n",
@@ -533,6 +534,10 @@
 	}
 	info->wtsr_en = pdata->wtsr_smpl->wtsr_en;
 	info->smpl_en = pdata->wtsr_smpl->smpl_en;
+#else
+	(void)val;
+	(void)ret;
+#endif
 }
 
