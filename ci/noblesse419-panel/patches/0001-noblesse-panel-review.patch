@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Adapted from Samsung's Noblesse panel control functions; see provenance. */
+#include "noblesse-panel-seq.h"
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "noblesse-panel-tables.h"
+#define NP_COUNT(a) (sizeof(a) / sizeof((a)[0]))
+
+static int validate(enum np_action action, const struct np_config *c,
+		    const struct np_io *io)
+{
+	if (!c || !io || !io->write || !io->delay_ms)
+		return -EINVAL;
+	if (!c->identity_verified || (c->variant != NP_SDC && c->variant != NP_BOE))
+		return -ENODEV;
+	if (action < NP_INIT || action > NP_SUSPEND)
+		return -EINVAL;
+	/* Neither optional debug nor factory fast-discharge sequence is ported. */
+	if (c->ddi_debug || c->fast_discharge)
+		return -EOPNOTSUPP;
+	if (action == NP_INIT && c->variant == NP_SDC) {
+		if (!c->cal.ready)
+			return -ENODATA;
+		if (c->cal.gamma[0] != 0xca || c->cal.aid[0] != 0xb1 ||
+		    c->cal.elvss[0] != 0xb5 || c->cal.vbias[0] != 0xba)
+			return -EINVAL;
+	}
+	return 0;
+}
+
+static int send(const struct np_io *io, enum np_packet type,
+		const np_u8 *data, size_t count)
+{
+	int ret = io->write(io->cookie, type, data, count);
+	return ret < 0 ? ret : 0;
+}
+
+int np_run(enum np_action action, const struct np_config *c, const struct np_io *io)
+{
+	int ret, cleanup;
+	ret = validate(action, c, io);
+	if (ret)
+		return ret;
+#define SEND(type, data, count) do { \
+	ret = send(io, type, data, count); if (ret) goto finish; \
+} while (0)
+#define LONG(data) SEND(NP_LONG, data, NP_COUNT(data))
+	if (c->variant == NP_SDC) {
+		/* On a failed unlock, acceptance is unknown: attempt key-off as well. */
+		LONG(TEST_KEY_ON_0);
+		if (action == NP_INIT) {
+			SEND(NP_SHORT, SLPOUT, 1);
+			io->delay_ms(io->cookie, 20);
+			LONG(TEON);
+			LONG(c->cal.gamma);
+			LONG(c->cal.aid);
+			LONG(c->cal.elvss);
+			LONG(F4_GPARA);
+			if ((c->id3 & 0x0f) >= 4)
+				SEND(NP_SHORT_PARAM, NORMAL_VINT, 2);
+			else
+				SEND(NP_SHORT_PARAM, NORMAL_VINT_OLD, 2);
+			LONG(c->cal.vbias);
+			SEND(NP_SHORT_PARAM, GAMMA_UPDATE, 2);
+			LONG(FFC_ON);
+			if (c->circle_mask)
+				LONG(CIRCLE_MASK_ON);
+			else
+				LONG(CIRCLE_MASK_OFF);
+		} else if (action == NP_DISPLAY_ON) {
+			SEND(NP_SHORT, DISPLAY_ON, 1);
+		} else {
+			SEND(NP_SHORT, DISPLAY_OFF, 1);
+			SEND(NP_SHORT, SLEEP_IN, 1);
+			io->delay_ms(io->cookie, 120);
+		}
+	} else {
+		if (action == NP_INIT) {
+			LONG(RM69091_USER_CMD);
+			LONG(RM69091_TE_ON);
+			if (c->id3 >= 0x81) {
+				LONG(RM69091_MANUFACTURE_01);
+				LONG(RM69091_IDLE_EXT_POWER);
+			}
+			LONG(RM69091_USER_CMD);
+			LONG(RM69091_DISPLAY_CTRL);
+			LONG(RM69091_COLUMN_SET);
+			LONG(RM69091_ROW_SET);
+			LONG(RM69091_DISP_BRIGHTNESS);
+			LONG(RM69091_SLEEP_OUT);
+			if (!c->curve) {
+				LONG(RM69091_MANUFACTURE_0C);
+				LONG(RM69091_DISABLE_CURVE);
+			}
+			io->delay_ms(io->cookie, 50);
+		} else if (action == NP_DISPLAY_ON) {
+			LONG(RM69091_DISP_ON);
+		} else {
+			LONG(RM69091_DISP_OFF);
+			LONG(RM69091_SLEEP_IN);
+			io->delay_ms(io->cookie, 83);
+		}
+	}
+	ret = 0;
+finish:
+	/* Preserve the first transport error if the best-effort key-off also fails.
+	 * BOE has no guessed bank/power recovery sequence. No automatic retry. */
+	if (c->variant == NP_SDC) {
+		cleanup = send(io, NP_LONG, TEST_KEY_OFF_0, NP_COUNT(TEST_KEY_OFF_0));
+		if (!ret)
+			ret = cleanup;
+	}
+#undef LONG
+#undef SEND
+	return ret;
+}
--- /dev/null
+++ b/drivers/video/fbdev/exynos/dpu30/panels/noblesse-panel-seq.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef NOBLESSE_PANEL_SEQ_H
+#define NOBLESSE_PANEL_SEQ_H
+#ifdef __KERNEL__
+#include <linux/types.h>
+typedef u8 np_u8;
+#else
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+typedef uint8_t np_u8;
+#endif
+
+enum np_variant { NP_UNCONFIRMED, NP_SDC, NP_BOE };
+enum np_action { NP_INIT, NP_DISPLAY_ON, NP_SUSPEND };
+enum np_packet { NP_SHORT = 0x05, NP_SHORT_PARAM = 0x15, NP_LONG = 0x39 };
+
+/* Caller-provided, per-panel values prepared by the dimming/calibration code.
+ * No default calibration and no calibration reader are supplied by this core. */
+struct np_sdc_cal {
+	bool ready;
+	np_u8 gamma[35], aid[3], elvss[4], vbias[9];
+};
+struct np_config {
+	enum np_variant variant;
+	bool identity_verified;
+	np_u8 id3; /* Full ID byte: SDC uses its low nibble; BOE uses all 8 bits. */
+	bool circle_mask, curve;
+	bool ddi_debug, fast_discharge;
+	struct np_sdc_cal cal;
+};
+struct np_io {
+	void *cookie;
+	int (*write)(void *, enum np_packet, const np_u8 *, size_t);
+	void (*delay_ms)(void *, unsigned int);
+};
+/* Normal-mode control-sequence helper, not a platform driver or panel probe.
+ * Power/reset/DSIM readiness, operation order, identity and calibration must
+ * be established by a future caller. Negative errors never mean panel rollback. */
+int np_run(enum np_action, const struct np_config *, const struct np_io *);
+#ifdef __KERNEL__
+struct exynos_panel_device;
+int noblesse_panel_sequence(struct exynos_panel_device *, enum np_action,
+			    const struct np_config *);
+#endif
+#endif
