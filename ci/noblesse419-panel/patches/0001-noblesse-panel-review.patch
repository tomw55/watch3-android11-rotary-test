+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included only by exynos_panel_drv.c with the default-off review option. */
+static int noblesse_parse_named_gpios(struct exynos_panel_device *panel)
+{
+	struct device *dev = panel->dev;
+	struct device_node *n = dev->of_node;
+	struct exynos_panel_resources *res = &panel->res;
+	int reset, ub, error, ret;
+	res->lcd_reset = -1;
+	res->lcd_power[0] = -1;
+	res->lcd_power[1] = -1;
+	res->mux_select = -1;
+	res->mux_output_enable = -1;
+	res->ub_detect = -1;
+	res->err_fg = -1;
+	/* Reject an ambiguous mixture rather than reusing positional power GPIOs. */
+	if (of_get_property(n, "gpios", NULL))
+		return -EINVAL;
+	reset = of_get_named_gpio(n, "reset-gpios", 0);
+	if (reset < 0)
+		return reset;
+	ub = of_get_named_gpio(n, "ub-detect-gpios", 0);
+	if (ub < 0)
+		return ub;
+	error = of_get_named_gpio(n, "error-gpios", 0);
+	if (error < 0)
+		return error;
+	if (reset == ub || reset == error || ub == error)
+		return -EINVAL;
+	/* Reset is resolved only; existing reset logic must be separately reviewed.
+	 * The two detection lines can only be requested as inputs here. */
+	ret = devm_gpio_request_one(dev, ub, GPIOF_IN, "noblesse-ub-detect");
+	if (ret)
+		return ret;
+	ret = devm_gpio_request_one(dev, error, GPIOF_IN, "noblesse-error");
+	if (ret)
+		return ret;
+	res->lcd_reset = reset;
+	res->ub_detect = ub;
+	res->err_fg = error;
+	return 0;
+}
