+#ifdef MINIGBM_QEMU49_RENDER_2D
+/* Explicit opt-in for the disposable QEMU profile. No Samsung display support. */
+static int qemu49_rgb_create(struct bo *bo, uint32_t width, uint32_t height, uint32_t format)
+{
+	struct drm_virtgpu_resource_create rc = {0};
+	uint32_t stride, resource_height, size;
+	int ret;
+
+	if (format != DRM_FORMAT_ABGR8888 && format != DRM_FORMAT_ARGB8888 &&
+	    format != DRM_FORMAT_XRGB8888 && format != DRM_FORMAT_XBGR8888)
+		return -EINVAL;
+	ret = qemu49_rgb_layout(width, height, &stride, &resource_height, &size);
+	if (ret)
+		return ret;
+	rc.target = PIPE_TEXTURE_2D;
+	rc.format = translate_format(format);
+	/* 2D host rows use resource width, not an independently padded stride. */
+	rc.width = stride / 4;
+	rc.height = resource_height;
+	rc.stride = stride;
+	rc.size = size;
+	rc.depth = rc.array_size = 1;
+	if (drmIoctl(bo->drv->fd, DRM_IOCTL_VIRTGPU_RESOURCE_CREATE, &rc))
+		return -errno;
+	bo->meta.num_planes = 1;
+	bo->meta.strides[0] = stride;
+	bo->meta.offsets[0] = 0;
+	bo->meta.sizes[0] = bo->meta.total_size = size;
+	bo->handles[0].u32 = rc.bo_handle;
+	return 0;
+}
+#endif
