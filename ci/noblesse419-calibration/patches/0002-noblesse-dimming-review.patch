+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Samsung SDC large-panel math/tables, isolated for offline review.
+ * Original formulas Copyright Samsung Electronics; see evidence and COPYING. */
+#include "noblesse-dimming.h"
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#define ND_ALLOC(n) kzalloc(n, GFP_KERNEL)
+#define ND_FREE(p) kfree(p)
+#else
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#define ND_ALLOC(n) calloc(1, n)
+#define ND_FREE(p) free(p)
+#endif
+#define pr_err(...) ((void)0)
+#define printk(...) ((void)0)
+#include "noblesse-dimming-internal.h"
+#include "noblesse-dimming-tables.inc"
+#include "noblesse-dimming-math.inc"
+
+/* math uses unsigned long products; ARM64 and the x86_64 host are both LP64. */
+typedef char nd_requires_64bit_long[sizeof(unsigned long) == 8 ? 1 : -1];
+struct nd_context {
+	struct dim_data workspace;
+	np_u8 gamma[MAX_BR_INFO][GAMMA_CMD_CNT];
+	np_u8 id3, base_vbias;
+};
+
+int nd_create(const struct nd_input *in, struct nd_context **out)
+{
+	struct nd_context *ctx;
+	struct dim_data *data;
+	const struct SmtDimInfo *info;
+	struct SmtDimInfo row;
+	const np_u8 *mtp;
+	int i, j, pos = 0, temp, ret;
+	bool zero = true, ones = true;
+	if (!out) return -EINVAL;
+	*out = NULL;
+	if (!in || !in->mtp || in->mtp_len != 34) return -EINVAL;
+	if (!in->large_panel_verified || !in->id_read_ok || in->id[0] != 0x40)
+		return -ENODEV;
+	if (!in->mtp_read_ok || !in->vbias_read_ok) return -ENODATA;
+	mtp = in->mtp;
+	for (i = 0; i < 34; i++) {
+		if (mtp[i] != 0) zero = false;
+		if (mtp[i] != 255) ones = false;
+	}
+	/* Conservative audit policy: do not silently substitute source defaults. */
+	if (zero || ones) return -ENODATA;
+	ctx = ND_ALLOC(sizeof(*ctx));
+	if (!ctx) return -ENOMEM;
+	ctx->id3 = in->id[2];
+	ctx->base_vbias = in->base_vbias;
+	data = &ctx->workspace;
+#include "noblesse-dimming-decode.inc"
+	if ((ctx->id3 & 15) >= 4) info = s6e36w4x01_dimming_info_latest;
+	else if ((ctx->id3 & 15) >= 3) info = s6e36w4x01_dimming_info_0x83;
+	else info = s6e36w4x01_dimming_info_old;
+	ret = s6e36w4x01_generate_volt_table(data);
+	if (ret) goto fail;
+	for (i = 0; i < MAX_BR_INFO; i++) {
+		row = info[i]; /* Never cast away const or modify Samsung metadata. */
+		if (row.way != DIMMING_METHOD_AID) { ret = -EOPNOTSUPP; goto fail; }
+		ret = s6e36w4x01_cal_gamma_from_index(data, &row);
+		if (ret) goto fail;
+		memcpy(ctx->gamma[i], row.gamma, GAMMA_CMD_CNT);
+	}
+	memcpy(ctx->gamma[73], MAX_GAMMA_SET, GAMMA_CMD_CNT);
+	*out = ctx;
+	return 0;
+fail:
+	ND_FREE(ctx);
+	return ret;
+}
+
+void nd_destroy(struct nd_context *ctx) { ND_FREE(ctx); }
+
+int nd_prepare(const struct nd_context *ctx, unsigned int brightness,
+	       bool hop, np_u8 temperature, struct nd_frame *out)
+{
+	struct nd_frame frame;
+	const unsigned char *aid, *vint = NULL;
+	const signed char *vbias;
+	unsigned int rev, level;
+	int bias;
+	static const np_u8 base[] = { 0xba, 0x21, 0x02, 0x32, 0x50, 0xcc, 0x1e, 0x1e, 0x00 };
+	if (!out) return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	if (!ctx || brightness > 100) return -EINVAL;
+	memset(&frame, 0, sizeof(frame));
+	level = s6e36w4x01_br_tbl[brightness];
+	if (level >= MAX_BR_INFO) return -ERANGE;
+	rev = ctx->id3 & 15;
+	if (rev >= 4) {
+		aid = s6e36w4x01_aid_latest;
+		vbias = s6e36w4x01_vbias_30hz_latest;
+		vint = s6e36w4x01_vint_latest;
+	} else if (rev >= 3) {
+		aid = s6e36w4x01_aid_0x83;
+		vbias = s6e36w4x01_vbias_30hz_0x83;
+		vint = s6e36w4x01_vint_0x83;
+	} else {
+		aid = s6e36w4x01_aid;
+		vbias = s6e36w4x01_vbias;
+	}
+	bias = (int)ctx->base_vbias + vbias[level];
+	if (bias < 0 || bias > 255) return -ERANGE;
+	memcpy(frame.cal.gamma, ctx->gamma[level], 35);
+	frame.cal.aid[0] = 0xb1;
+	frame.cal.aid[1] = aid[level * 2];
+	frame.cal.aid[2] = aid[level * 2 + 1];
+	frame.cal.elvss[0] = 0xb5;
+	frame.cal.elvss[1] = temperature;
+	frame.cal.elvss[2] = s6e36w4x01_mps_con[level];
+	frame.cal.elvss[3] = s6e36w4x01_elvss[level];
+	memcpy(frame.cal.vbias, base, sizeof(base));
+	frame.cal.vbias[1] = hop ? 0x21 : 0x20;
+	frame.cal.vbias[8] = (np_u8)bias;
+	frame.has_vint = rev >= 3;
+	if (frame.has_vint) {
+		frame.vint[0] = 0xf4;
+		frame.vint[1] = vint[level];
+	}
+	frame.id3 = ctx->id3;
+	frame.level = level;
+	frame.cal.ready = true; /* Publish only fully validated frame. */
+	*out = frame;
+	return 0;
+}
+
+int nd_send(const struct nd_frame *f, const struct np_io *io)
+{
+	int ret, cleanup;
+	if (!f || !io || !io->write) return -EINVAL;
+	if (!f->cal.ready) return -ENODATA;
+	if (f->level >= MAX_BR_INFO || f->cal.gamma[0] != 0xca ||
+	    f->cal.aid[0] != 0xb1 || f->cal.elvss[0] != 0xb5 ||
+	    f->cal.vbias[0] != 0xba || f->has_vint != ((f->id3 & 15) >= 3) ||
+	    (f->has_vint && f->vint[0] != 0xf4)) return -EINVAL;
+#define WRITE(type, bytes, n) do { \
+	ret = io->write(io->cookie, type, bytes, n); if (ret < 0) goto finish; \
+} while (0)
+#define LONG(bytes) WRITE(NP_LONG, bytes, sizeof(bytes))
+	LONG(TEST_KEY_ON_0);
+	LONG(f->cal.gamma);
+	LONG(f->cal.aid);
+	LONG(f->cal.elvss);
+	if (f->has_vint) {
+		LONG(F4_GPARA);
+		WRITE(NP_SHORT_PARAM, f->vint, 2);
+	}
+	LONG(f->cal.vbias);
+	WRITE(NP_SHORT_PARAM, PANEL_UPDATE, 2);
+	ret = 0;
+finish:
+	cleanup = io->write(io->cookie, NP_LONG, TEST_KEY_OFF_0, sizeof(TEST_KEY_OFF_0));
+	return ret < 0 ? ret : (cleanup < 0 ? cleanup : 0);
+#undef LONG
+#undef WRITE
+}
