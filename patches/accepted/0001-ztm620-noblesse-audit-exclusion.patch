--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1222,6 +1222,15 @@
          To compile this driver as a module, choose M here: the
          module will be called ZXT_ZTM620.
 
+config TOUCHSCREEN_ZTM620_NOBLESSE_AUDIT
+	bool "Omit ZTM620 driver for Noblesse audit"
+	depends on NOBLESSE && TOUCHSCREEN_ZXT_ZTM620
+	default n
+	help
+	  Omit all ZTM620 variant objects from this touchscreen Makefile.
+	  No ZTM620 probe, factory command or touchscreen input device is
+	  available. Board identity can be inspected in the device tree.
+
 config TOUCHSCREEN_ZXT_ZTM630
         tristate "Zinitix ZXT_ZTM630 touchscreen"
         depends on I2C
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -100,6 +100,7 @@
 obj-$(CONFIG_TOUCHSCREEN_COLIBRI_VF50)	+= colibri-vf50-ts.o
 obj-$(CONFIG_TOUCHSCREEN_ROHM_BU21023)	+= rohm_bu21023.o
 obj-$(CONFIG_TOUCHSCREEN_ZXT_ZTM630)    += zxt_ztm630_ts.o
+ifneq ($(CONFIG_TOUCHSCREEN_ZTM620_NOBLESSE_AUDIT),y)
 ifdef CONFIG_PULSE
 obj-$(CONFIG_TOUCHSCREEN_ZXT_ZTM620)    += zxt_ztm620_ts_pulse.o
 else
@@ -113,6 +114,7 @@
 endif
 endif
 endif
+endif # Noblesse audit
 obj-$(CONFIG_TOUCHSCREEN_SEC_TS)	+= sec_ts/
 obj-$(CONFIG_TOUCHSCREEN_SEC_TS_A552)	+= sec_ts_a552/
 obj-$(CONFIG_TOUCHSCREEN_IST30XXC)  +=	imagis_30xxc/
--- a/drivers/input/touchscreen/zxt_ztm620_ts_noblesse.c
+++ b/drivers/input/touchscreen/zxt_ztm620_ts_noblesse.c
@@ -14,6 +14,10 @@
  * GNU General Public License for more details.
  *
  */
+
+#ifdef CONFIG_TOUCHSCREEN_ZTM620_NOBLESSE_AUDIT
+#error "Noblesse audit must not compile the operational ZTM620 driver"
+#endif
 
 #ifdef CONFIG_OF
 #include <linux/pinctrl/consumer.h>
