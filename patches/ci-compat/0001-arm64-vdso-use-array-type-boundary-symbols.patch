# ci-compat patch -- NOT a safety-audit patch.
#
# Category: compiler-compatibility source fix, evidence-driven, added in
# response to GCC 11.4.0 -Werror=stringop-overread on vdso.o
# (arch/arm64/kernel/vdso.c:127) from GitHub Actions artifact
# watch3-r840-kernel-build-43764192145.zip.
#
# vdso_start/vdso_end are linker-script boundary labels for a multi-page
# .incbin-included blob (arch/arm64/kernel/vdso/vdso.S:24-30), not real
# 1-byte objects. Declaring them as scalar `extern char` makes GCC's
# -Wstringop-overread believe memcmp() is reading 4 bytes from a 1-byte
# object. This tree's own arch/tile and arch/x86/um vdso code already
# avoids this by declaring the equivalent boundary symbols as incomplete
# ARRAY type (`extern char foo[], bar[];`) instead. This patch applies
# the same, already-precedented declaration style to arch/arm64, and
# drops the now-redundant `&` at each use site. This is a pure
# compile-time type annotation fix: confirmed byte-identical generated
# assembly before/after (see README.md "CI fix log"), so it changes no
# behavior and touches no ABI, linker script, or .S file.
#
# See the main README.md "CI fix log" section for full evidence,
# including a host-side reproduction of both the failure and the fix.
--- a/arch/arm64/kernel/vdso.c
+++ b/arch/arm64/kernel/vdso.c
@@ -37,7 +37,7 @@
 #include <asm/vdso.h>
 #include <asm/vdso_datapage.h>
 
-extern char vdso_start, vdso_end;
+extern char vdso_start[], vdso_end[];
 static unsigned long vdso_pages __ro_after_init;
 
 /*
@@ -124,14 +124,14 @@
 	int i;
 	struct page **vdso_pagelist;
 
-	if (memcmp(&vdso_start, "\177ELF", 4)) {
+	if (memcmp(vdso_start, "\177ELF", 4)) {
 		pr_err("vDSO is not a valid ELF object!\n");
 		return -EINVAL;
 	}
 
-	vdso_pages = (&vdso_end - &vdso_start) >> PAGE_SHIFT;
+	vdso_pages = (vdso_end - vdso_start) >> PAGE_SHIFT;
 	pr_info("vdso: %ld pages (%ld code @ %p, %ld data @ %p)\n",
-		vdso_pages + 1, vdso_pages, &vdso_start, 1L, vdso_data);
+		vdso_pages + 1, vdso_pages, vdso_start, 1L, vdso_data);
 
 	/* Allocate the vDSO pagelist, plus a page for the data. */
 	vdso_pagelist = kcalloc(vdso_pages + 1, sizeof(struct page *),
@@ -144,7 +144,7 @@
 
 	/* Grab the vDSO code pages. */
 	for (i = 0; i < vdso_pages; i++)
-		vdso_pagelist[i + 1] = pfn_to_page(PHYS_PFN(__pa(&vdso_start)) + i);
+		vdso_pagelist[i + 1] = pfn_to_page(PHYS_PFN(__pa(vdso_start)) + i);
 
 	vdso_spec[0].pages = &vdso_pagelist[0];
 	vdso_spec[1].pages = &vdso_pagelist[1];
