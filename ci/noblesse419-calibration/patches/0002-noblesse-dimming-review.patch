@@ -0,0 +1,32 @@
+/* Samsung init_dimming MTP decode, not read_gamma(). pos initially zero. */
+	for (j = 0; j < CI_MAX; j++) {
+		pos += 1;
+		temp = ((mtp[0] & (0x01<<(2-j))) ? -1 : 1) * mtp[pos];
+		data->t_gamma[V255][j] = (int)center_gamma[V255][j] + temp;
+		data->mtp[V255][j] = temp;
+	}
+	pos += 1;
+
+	for (i = V203; i >= 0; i--) {
+		for (j = 0; j < CI_MAX; j++) {
+			temp = ((mtp[pos] & 0x80) ? -1 : 1) * (mtp[pos] & 0x7f);
+			data->t_gamma[i][j] = (int)center_gamma[i][j] + temp;
+			data->mtp[i][j] = temp;
+			pos++;
+		}
+	}
+
+	/* for v0 */
+	temp = ((mtp[pos] & 0xF0) >> 4) | ((mtp[pos] & 0x0F) << 4) | ((mtp[pos + 1] & 0xF0) << 4);
+	for (i = 0; i < CI_MAX; i++) {
+		data->v0_mtp[i] = (temp >> (i * 4)) & 0x0f;
+	}
+
+	pos++;
+	/* for vt */
+	temp = (mtp[pos] & 0x0F) | (mtp[pos + 1] & 0xF0) | ((mtp[pos + 1] & 0x0F) << 8);  // B, G, R
+
+	for (i = 0; i < CI_MAX; i++) {
+		data->vt_mtp[i] = (temp >> (i * 4)) & 0x0f;
+	}
+
